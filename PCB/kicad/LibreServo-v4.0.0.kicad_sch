	(text "NEEDS: footprint/package, board placement, and a new 5V regulator\nfor VCC (+5V_ISO_CANFD net) -- board has no 5V rail today.\nCAN-FD bus connectors ARE now on-sheet: U$26/U$27, JST-PH-3, deliberately 3-way so they\ncannot cross-mate with the 4-way RS-485 connectors (which carry +7V).\nR22/R23/C41 are a split termination, DO NOT POPULATE except on an end-of-bus node.\nSee PCB/MSPM0G3507-MCU-swap.md."
		(exclude_from_sim no)
		(at 264.16 466.09 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "2596c0a2-250b-4091-a795-e775feb068ad")
	)
